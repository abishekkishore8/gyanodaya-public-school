{
  "name": "gyanodaya-public-school",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website and content management portal for Gyanodaya Public School, Bagodar.",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-8443}",
    "build": "next build",
    "start": "next start --port ${PORT:-8443}",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "admin:password": "tsx --conditions=react-server scripts/reset-password.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
