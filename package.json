{
  "name": "gyanodaya-public-school",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website and content management portal for Gyanodaya Public School, Bagodar.",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-8443}",
    "build": "next build",
    "start": "next start --port ${PORT:-8443}",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:password": "tsx scripts/reset-password.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:schema": "wrangler d1 execute gps --file=./schema.sql",
    "db:migrate-from-mongo": "tsx scripts/migrate-mongo-to-d1.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mongodb": "^7",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "wrangler": "^4.135.0"
  }
}
